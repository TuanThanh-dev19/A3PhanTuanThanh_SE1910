{
  "info": {
    "name": "A3-03 - Staff management",
    "description": "Author: Phan Tuan Thanh - CE190595. Local requests; credentials and tokens exist only in runtime variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8081"
    },
    {
      "key": "invalidToken",
      "value": "invalid.token.value"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Author: Phan Tuan Thanh - CE190595",
          "if (!pm.collectionVariables.get('customerEmail')) { const id = pm.variables.replaceIn('{{$guid}}'); pm.collectionVariables.set('customerEmail', 'a3pm-' + id.slice(0,20) + '@example.test'); pm.collectionVariables.set('customerPassword', 'Customer!' + id); pm.collectionVariables.set('wrongPassword', 'Wrong!' + id); }",
          "if (!pm.collectionVariables.get('managedEmail')) pm.collectionVariables.set('managedEmail', 'a3managed-' + Date.now() + '@example.test');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Public rooms",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/rooms"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Author: Phan Tuan Thanh - CE190595",
              "pm.test('Public rooms: HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Seeded room catalog', () => pm.expect(pm.response.json().length).to.be.at.least(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "Register customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"profile\": {\"customerFullName\": \"Postman Customer\", \"telephone\": \"0901234567\", \"emailAddress\": \"{{customerEmail}}\", \"customerBirthday\": \"2000-01-01\"}, \"password\": \"{{customerPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Author: Phan Tuan Thanh - CE190595",
              "pm.test('Register customer: HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('customerId', pm.response.json().customerId);",
              "pm.test('Safe customer DTO', () => pm.expect(pm.response.json()).not.to.have.property('password'));"
            ]
          }
        }
      ]
    },
